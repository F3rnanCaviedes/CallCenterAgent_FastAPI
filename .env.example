# ═══════════════════════════════════════════════════════
#  VoiceScheduler Agent — Sofía | .env.example
#  Copia este archivo como .env y completa los valores.
#  NUNCA commitees el .env real al repositorio.
# ═══════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────
APP_ENV=development                     # development | staging | production
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=America/Bogota
# URL publica exacta registrada en Twilio (valida la firma del webhook).
PUBLIC_BASE_URL=https://sofia.tuclinica.com
SESSION_TTL_SECONDS=1800
MAX_CONVERSATION_TURNS=20

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                   # Opcional (fallback STT)
LLM_MODEL=claude-sonnet-4-6

# ── Seguridad ──────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=cambia_esto_por_un_secreto_de_64_hex_chars
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=cambia_esto_por_otro_secreto_de_64_hex_chars
ALLOWED_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=30

# Claves de los backends de cliente autorizados a pedir tokens en
# POST /v1/auth/token. Lista JSON. Vacia = endpoint desactivado (503).
# Quien tiene una de estas claves puede emitir un token para CUALQUIER
# user_id: son claves servidor-a-servidor, nunca van al navegador.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_API_KEYS=["cambia_esto_por_una_clave_por_cada_backend_cliente"]
ACCESS_TOKEN_TTL_SECONDS=3600

# Clave del cron interno que dispara POST /v1/reminders/trigger.
# Separada de CLIENT_API_KEYS: comprometer el portal no debe habilitar
# ademas el envio masivo de notificaciones. Vacia = endpoint cerrado (503).
INTERNAL_API_KEYS=["cambia_esto_por_la_clave_del_scheduler"]

# ── Base de Datos ──────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/sofia_db
REDIS_URL=redis://localhost:6379/0

# ── Voz — STT (Deepgram) ──────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# es-419 = espanol latinoamericano. "es" tira a peninsular.
DEEPGRAM_LANGUAGE=es-419
# Silencio (ms) antes de dar la frase por cerrada. Calibrar con llamadas
# reales: mas bajo = Sofia responde antes pero corta a quien piensa.
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# ── Voz — TTS (Azure) ─────────────────────────────────
TTS_PROVIDER=azure_neural
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
# Confirmar contra el endpoint /voices/list de tu recurso y region.
AZURE_TTS_VOICE=es-CO-SalomeNeural
AZURE_TTS_LANGUAGE=es-CO
ELEVENLABS_API_KEY=

# ── Notificaciones ────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=SG...
NOTIFICATION_EMAIL_FROM=citas@tuempresa.com
